# SEVE streaming worker — environment.
# Local: copy to worker/.env (or rely on the repo-root .env.local, which config.ts
# also loads for ALPACA_KEY/SECRET + the anon key). Railway: set these as service
# variables. NEVER commit real keys.

# ---- Alpaca (paper account; the data sub is on the SAME account) ----
ALPACA_KEY=
ALPACA_SECRET=

# ---- Supabase ----
# Railway: set SUPABASE_URL + the SERVICE ROLE key (full read/write).
# Local: the repo .env.local provides NEXT_PUBLIC_SUPABASE_URL + the anon key →
# the worker runs READ-ONLY shadow (logs intents, writes nothing).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Data feeds (same two names as market-ingest's Supabase secrets) ----
# Stock-bar websocket: iex (free, runs now) → sip (real-time, Algo Trader Plus).
STOCK_FEED=iex
# Option-quote REST snapshot: indicative (free, ~15-min delayed) → opra (real-time
# NBBO, Algo Trader Plus).
OPT_FEED=indicative

# ---- Posture (Phase A = SHADOW) ----
# DRY_RUN must be true in v1 (shadow-only). Live order placement is Phase B.
DRY_RUN=true
# Mirror intended signals into the `events` table (tagged `stream-shadow:`) for
# dashboard comparison vs the cron worker. Needs the service role. Default off.
SHADOW_WRITE_EVENTS=false

# ---- Optional overrides ----
# SYMBOL=SPY
# STRIKE_WINDOW=8
# BAR_HISTORY=900

    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1086.0",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "tsx": "^4.22.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.3"
  }
}

# SEVE — Live Market Monitor
# Copy this file to `.env.local` and fill in your project values.
#
# Both of these are PUBLIC/safe to ship to the browser (NEXT_PUBLIC_ prefix):
#   - The URL is just your project endpoint.
#   - The anon (publishable) key is public by design; row-level security
#     governs what it can read. The three dashboard tables have SELECT policies.
#
# NEVER put your service-role / secret key in this app. It must not appear here
# or anywhere in the repo.

NEXT_PUBLIC_SUPABASE_URL=https://xvdfsxwwedltvdktqdac.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_YOUR_PUBLISHABLE_ANON_KEY_HERE
